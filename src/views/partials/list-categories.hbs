{{#each categories}}
<section class="columns box pt-2 mx-1 mb-5">
  <section class="column is-8">
    <div class="box-link-hover-shadow">
    <h2 class="title">
      <a href="/category/{{_id}}" class="has-text-grey">{{title}}</a>
    </h2>
    <div class="notes">
    <div class="content card-content">
      <p class="subtitle"> {{notes}} </p>
      <a href="/category/{{_id}}" class="button">
      <span class="icon is-small">
      <i class="fas fa-solid fa-folder-open"></i>
      </span>
      </a>
      <a href="/dashboard/deletecategory/{{_id}}" class="button">
      <span class="icon is-small">
      <i class="fas fa-solid fa-trash"></i>
      </span>
      </a>
    </div>
  </section>
  <section class="column is-4">
    <div class="card-image">
      <a href="/category/{{_id}}">
        <figure class="image is-264x264">
          <img src="{{image}}" style="border-radius: 10px;" />
        </figure>
      </a>
    </div>
  </section>
</section>
{{/each}}