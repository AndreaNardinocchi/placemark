<form class="box" action="/category/{{category._id}}/updateplacemark/{{placemark._id}}" method="POST">
  <label>Update Placemark Details:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Title</label><input class="input" type="text" placeholder="Enter Title" name="title" value="{{placemark.title}}" />
      </div>
      <div class="field">
        <label class="label">Latitude</label><input class="input" type="number" step="any" placeholder="Enter Longitude" name="lat" value="{{placemark.lat}}" />
      </div>
      <div class="field">
        <label class="label">Longitude</label><input class="input" type="number" step="any" placeholder="Enter Latitude" name="long" value="{{placemark.long}}" />
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Address</label><input class="input" type="text" placeholder="Enter address" name="address" value="{{placemark.address}}" />
      </div>
      <div class="field">
        <label class="label">Country</label><input class="input" type="text" placeholder="Enter country" name="country" value="{{placemark.country}}" />
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Phone Number</label><input class="input" type="number" placeholder="Enter phone number" name="phone" value="{{placemark.phone}}" />
      </div>
      <div class="field">
        <label class="label">Website</label><input class="input" type="text" placeholder="Enter website URL" name="website" value="{{placemark.website}}" />
      </div>
      <div class="field">
        <label class="label">Visited?</label>
        <select
          class="p-2"
          name="visited"
          type="text"
          placeholder="Select your Category"
          style="font-size:100%; width: 100%; border-radius: 10px;   box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.005), 0 6px 20px 0 rgba(0, 0, 0, 0.13); border-color: #d9d9d9 " value="{{placemark.visited}}"
          >
          <option value="" disabled selected>Select your answer</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Description</label>
        <div class="control">
          <textarea class="textarea" type="text" placeholder="Enter a description" name="description">{{placemark.description}}</textarea>
        </div>
      </div>
    </div>
  </div>
  <div class = "columns">
    <div class = "column is-6">
      <button class="button is-info has-text-white">Update your placemark</button>
      <a class="button is-dark has-text-white" href="/category/{{category._id}}">Do not update</a>
    </div>
    <div class = "column is-6">
      <p class=" has-text-right">
        *Find your exact placemarks coordinates on
        <a href="https://www.gps-coordinates.net/" target="_blank" class="has-text-grey">https://www.gps-coordinates.net/ </a>
        <span class="ml-1 icon is-small">
        <i class="fas fa-solid fa-folder-open"></i>
        </span>
        </span>
    </div>
  </div>
</form>