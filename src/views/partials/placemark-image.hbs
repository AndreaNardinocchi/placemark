<div class="box p-4 pt-5 card-content">
  <form action="/category/{{category._id}}/placemark/{{placemark._id}}/uploadimage" method="POST" enctype="multipart/form-data">
    <div id="file-select" class="file has-name is-fullwidth">
      <label class="file-label">
        <input class="file-input" name="imagefile" type="file" accept="image/png, image/jpeg" multiple />
        <span class="file-cta has-text-white has-background-grey-dark">
          <span class="file-icon">
            <i class="fas fa-upload"></i>
          </span>
          <span class="file-label">
            Choose an image…
          </span>
        </span>
        <span class="file-name"></span>
      </label>
      <button type="submit" class="button is-info ml-4 has-text-white">Upload image</button>
      <a href="/category/{{category._id}}/placemark/{{placemark._id}}/deleteimage" class="button ml-2">
        <span class="icon is-small">
          <i class="fas fa-solid fa-trash"></i>
        </span>
      </a>
    </div>
  </form>
  {{#if placemark.image}}
    <div class="mt-4">
      <img id="placemark-image" src="{{placemark.image}}" alt="Placemark Image" style="max-width: 100%; display: block;" />
    </div>
  {{else}}
    <div class="mt-4">
      <img id="placemark-image" alt="Placemark Image" style="max-width: 100%; display: none;" />
    </div>
  {{/if}}
</div>
<script>

  // Get the necessary DOM elements const fileInput = document.querySelector(".file-input"); const placemarkImage = document.getElementById("placemark-image"); const
  fileNameDisplay = document.querySelector(".file-name"); // Hide the image by default if there's no uploaded image placemarkImage.style.display = "none"; // Display the image if
  it already exists when the page loads if (placemarkImage.src && placemarkImage.src !== "") { placemarkImage.style.display = "block"; // Show the image if it has a valid src } //
  When the user selects a file, preview the image fileInput.onchange = () => { if (fileInput.files.length > 0) { const fileName = fileInput.files[0].name;
  fileNameDisplay.textContent = fileName; // Show the file name // Show the image preview immediately after selection const reader = new FileReader(); reader.onload = () => {
  placemarkImage.src = reader.result; // Set the image source to the selected file placemarkImage.style.display = "block"; // Show the image };
  reader.readAsDataURL(fileInput.files[0]); // Read the selected file as a Data URL } };

</script>