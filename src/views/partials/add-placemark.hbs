<form class="box" action="/category/{{category._id}}/addplacemark" method="POST">
  <label>Enter Placemark Details:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Title</label><input class="input" type="text" placeholder="Enter Title" name="title"  />
      </div>
      <div class="field">
        <label class="label">Latitude</label><input class="input" type="text" placeholder="Enter Latitude" name="lat"  />
      </div>
      <div class="field">
        <label class="label">Longitude</label><input class="input" type="text" placeholder="Enter Longitude" name="long" />
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Address</label><input class="input" type="text" placeholder="Enter address" name="address" />
      </div>
      <div class="field">
        <label class="label">Country</label><input class="input" type="text" placeholder="Enter country" name="country" />
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Phone Number</label><input class="input" type="text" placeholder="Enter phone number" name="phone" />
      </div>
      <div class="field">
        <label class="label">Website</label><input class="input" type="text" placeholder="Enter website URL" name="website" />
      </div>
      <div class="field">
        {{! <label class="label">Visited?</label><input class="input" type="text" placeholder="Enter your answer" name="visited" /> }}

        <label class="label">Visited?</label>
        
        
        <select
      class="p-2"
      name="visited"
      type="text"
      placeholder="Select your Category"
      style="font-size:100%; width: 100%; border-radius: 10px;   box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.005), 0 6px 20px 0 rgba(0, 0, 0, 0.13); border-color: #d9d9d9 "
    >
    <option value="" disabled selected>Select your answer</option>
      <option value="Yes">Yes</option>
      <option value="No">No</option>
      
    </select>
        
        
        {{!-- <input class="input" type="text" placeholder="Select your answer" name="visited" list="visited" />
        <datalist id="visited">
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </datalist> --}}
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <div class="control">
          <label class="label">Description</label><textarea class="textarea" type="text" placeholder="Enter a description" name="description"></textarea>
        </div>
      </div>
    </div>
  </div>
  <div class = "columns">
    <div class = "column is-3">
  <button class="button is-info has-text-white">
    Add your placemark
  </button>
  </div>
  <div class = "column is-9">
  <p class=" has-text-right">
    *Find your exact placemarks coordinates on
    <a href="https://www.gps-coordinates.net/" target="_blank" class="has-text-grey">https://www.gps-coordinates.net/ </a>
    <span class="ml-1 icon is-small">
      <i class="fas fa-solid fa-folder-open"></i>
    </span>
  </span>
  </div>
  </div>
</form>