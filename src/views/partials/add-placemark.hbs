<form class="box" action="/category/{{category._id}}/addplacemark" method="POST">
  <label>Enter Placemark Details:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Title</label><input class="input" type="text" placeholder="Enter Title" name="title" value="{{category.title}}" />
      </div>
      <div class="field">
        <label class="label">Longitude</label><input class="input" type="text" placeholder="Enter Longitude" name="long" value="{{category.long}}" />
      </div>
      <div class="field">
        <label class="label">Latitude</label><input class="input" type="text" placeholder="Enter Latitude" name="lat" />
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Address</label><input class="input" type="text" placeholder="Enter address" name="address" />
      </div>
      <div class="field">
        <label class="label">Country</label><input class="input" type="text" placeholder="Enter country" name="country" />
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Phone Number</label><input class="input" type="number" placeholder="Enter phone number" name="phone" />
      </div>
      <div class="field">
        <label class="label">Website</label><input class="input" type="text" placeholder="Enter website URL" name="website" />
      </div>
      <div class="field">
        <label class="label">Visited?</label><input class="input" type="text" placeholder="Enter your answer" name="visited" value="{{placemark.visited}}" />
        {{!-- <label class="label">Visited?</label><input class="input" type="text" placeholder="Select your answer" name="visit" list="visit" value="{{visit}}" />
        <datalist id="visit">
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </datalist> --}}
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <div class="control">
          <label class="label">Description</label><textarea class="textarea" type="text" placeholder="Enter a description" name="description"></textarea>
        </div>
      </div>
    </div>
  </div>
  <button class="button is-info has-text-white">
    Add your placemark
  </button>
</form>