{{> menu}}
<section class="section mt-6">
  <div class="{{backgroundColor}}">
    <div class="card-image">
      <figure class="image 264x264 m-auto">
        <img src="{{imageCode}}" alt="placeholder" style="border-radius: 15px;"  border="0"> 
      </figure>
    </div>
    <div class="columns">
      <div class="column">
        <article class="card-content pt-2">
          <p class="card-header-title"> - {{category.title}} - </span></p>
          <p></p>
        </article>
      </div>
    </div>
  </div> 
    <div class="box has-background-white">
    <div class="columns">  
      <div class="column">
        <section class="">
          <header class="card-header ">
          </header>
          <div class="columns has-text-left">
            <div class="column is-6 m-auto">
              <div class="card-image ">
                <figure class="image is-264x264  p-2">
                  <img src="https://i.ibb.co/G42MNvjz/placemark.jpg" alt="placemark" border="0">
                </figure>
              </div>
            </div>
            <div class="column is-6 ml-3">
              <header class="card-header pt-5">
                <p class="subtitle has-text-weight-bold is-5">Your placemarks stats</p>
              </header>
              <hr class="mr-6 pr-4">
              <article class="card-content">
                <p class="content is-size-6 pt-1">
                  <span class=" has-text-weight-bold is-size-6" id="placenarkSum">Placemarks:</span> {{placemarkSum}}<br>
                  <span class=" has-text-weight-bold is-size-6" id="yesCounting">Visited:</span> {{yesCounting}}<br>
                  <span class="has-text-weight-bold is-size-6" id="noCounting"> To visit:</span> {{noCounting}}<br>
                  <span class=" has-text-weight-bold is-size-6" id="resultMax">Furthest placemark:</span><br> {{resultMax}}<br> 
                  <span class=" has-text-weight-bold is-size-6" id="resultMin">Closest placemark:</span><br> {{resultMin}}
                </p>
                </p>
                </p>
                <p></p>
              </article>
            </div>
          </div>
        </section>
      </div> 
      <div class="column ">
        <section class="">
          <header class="card-header ">
          </header>
          <div class="columns has-text-left">
            <div class="column m-auto is-6">
              <div class="card-image">
                <figure class="image is-264x264 pt-5">
                  <img src="https://i.ibb.co/s98MdtnM/travel.jpg" alt="travel"  border="0">
                </figure>
              </div>
            </div>
            <div class="column is-6 ml-3">
              <header class="card-header pt-5">
                <p class="subtitle has-text-weight-bold is-5">Placemarks locations</p>
              </header>
              <hr class="mr-6 pr-6">
              <article class="card-content">
                <p class="content is-size-6 pt-1">
                <p id="localCounting"><span class="has-text-weight-bold is-size-6" >Local:</span> {{localCounting}}     
                  <img src="{{localIcon}}" alt=""   border="0"> <i class="{{localTravelIcon}}" id="localTravelIcon"></i> 
                </p>
                <p id="abroadCounting"><span class=" has-text-weight-bold is-size-6">Abroad:</span> {{abroadCounting}} 
                  <img src="{{abroadIcon}}" class = "mt-2" alt=""  id="abroadCounting" border="0"> <i class="{{abroadTravelIcon}} " id="abroadTravelIcon"></i>    
                </p>
                </p>
                </p>
                <p></p>
              </article>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
  <img id="category-image" src="{{category.img }}" class="mb-5" style="border-radius: 10px; display: none;" />
  {{> list-placemarks}}
  {{> add-placemark}}
  {{> category-image }}
  {{> placemark-image}}
</section>