{{> welcome-menu active="login"}}

<section class="section mt-6">
  <h1 class="title pt-4 pb-6"> Log in </h1>
<section class="columns">
<section class = "column is-6 mt-5 pt-5 pr-4">
  <form action="/authenticate" method="POST">
    <div class="field">
      <label class="label">Email</label> <input class="input" type="text" placeholder="Enter email" name="email">
    </div>
    <div class="field">
      <label class="label">Password</label> <input class="input" type="password" placeholder="Enter Password" name="password">
    </div>
    <div class="field is-grouped">
      <button class="button is-info has-text-white">Submit</button>
    </div>
  </form>
</section>
<section class="column is-6 px-6">
  <section  class="image has-text-centered">
    <i class="fas fa-plane fa-10x" style="color: #000000;"></i>
  </section>
  <p class="title is-size-1 mt-3 pl-5">PlaceMark</p>
  <p class="subtitle has-text-weight-bold pl-5">Place your mark on your next journey!</p>

</section>